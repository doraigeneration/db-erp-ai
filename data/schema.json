        { "name": "Company", "airtableType": "singleLineText", "description": "שם החברה או העסק, אם יש.", "required": false, "example": "משרד אדריכלים ברקוביץ" },
        { "name": "Source", "airtableType": "singleLineText", "description": "מאיפה הגיע הליד.", "required": false, "allowedValues": ["Website", "Facebook", "Event", "Phone", "App"], "example": "Website" },
        { "name": "Interest", "airtableType": "singleLineText", "description": "במה הליד מתעניין, בתיאור קצר.", "required": false, "example": "רמקולים לחדר ישיבות" },
        { "name": "Status", "airtableType": "singleLineText", "description": "מצב הליד בתהליך המכירה. New בעת יצירה; WF04a מעביר ל-Contacted; WF04b מעביר ל-Replied, או ל-Unsubscribed כשהתשובה כוללת \"הסר\". ליד ב-Unsubscribed לא מקבל פניות נוספות.", "required": true, "allowedValues": ["New", "Contacted", "Replied", "Unsubscribed"], "example": "New" },
        { "name": "LastContacted", "airtableType": "date", "description": "התאריך שבו נשלחה הפנייה האחרונה. מתעדכן ב-WF04a.", "required": false, "example": "2026-10-05" },
        { "name": "Notes", "airtableType": "multilineText", "description": "הערות, כולל תוכן ההודעה המקורית מהטופס.", "required": false, "example": "ביקש הצעה ל-6 יחידות" },
        { "name": "Created", "airtableType": "createdTime", "description": "זמן יצירת הרשומה.", "required": true, "example": "2026-10-05T10:02:00.000Z" }
