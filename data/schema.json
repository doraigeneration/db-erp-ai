        { "name": "CustomerEmail", "airtableType": "email", "description": "כתובת המייל של הלקוח.", "required": false, "example": "office@gal-or.example" },
        { "name": "IssueDate", "airtableType": "date", "description": "תאריך המסמך. קובע את שיעור המע\"מ (17% לפני 01/01/2025, 18% מאז).", "required": true, "example": "2026-10-04" },
        { "name": "Amount", "airtableType": "currency", "description": "סכום לפני מע\"מ, בשקלים.", "required": true, "example": 1250.00 },
        { "name": "VatRate", "airtableType": "percent", "description": "שיעור המע\"מ שהוחל. מחושב ב-WF01 (נשמר כ-0.18).", "required": false, "example": 0.18 },
        { "name": "VatAmount", "airtableType": "currency", "description": "סכום המע\"מ. מחושב ב-WF01.", "required": false, "example": 225.00 },
        { "name": "Total", "airtableType": "currency", "description": "סכום כולל מע\"מ. מחושב ב-WF01.", "required": false, "example": 1475.00 },
        { "name": "Status", "airtableType": "singleLineText", "description": "מצב המסמך. New בעת יצירה; WF01 מעביר ל-Pending או Invalid; WF08 מעביר ל-Done.", "required": true, "allowedValues": ["New", "Pending", "Invalid", "Done"], "example": "Pending" },
        { "name": "PdfUrl", "airtableType": "url", "description": "קישור לקובץ המסמך בגוגל דרייב. נכתב על ידי WF08.", "required": false, "example": "https://drive.google.com/file/d/EXAMPLE_FILE_ID/view" },
        { "name": "Notes", "airtableType": "multilineText", "description": "הערות חופשיות, וגם סיבת פסילה שנכתבת על ידי WF01.", "required": false, "example": "שני מטעני USB-C ורמקול נייד" },
        { "name": "Created", "airtableType": "createdTime", "description": "זמן יצירת הרשומה. נדרש לטריגר של WF01.", "required": true, "example": "2026-10-04T08:15:00.000Z" }
      ]
    },
    {
