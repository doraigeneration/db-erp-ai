{
  "version": "1.0.0",
  "base": {
    "name": "Kilohertz ERP",
    "business": "קילוהרץ אלקטרוניקה (Kilohertz Electronics)",
    "platform": "Airtable",
    "description": "מקור האמת למודל הנתונים של מערכת ה-ERP-AI. ארבע טבלאות ליבה (core: true) נדרשות לעשרת התהליכים; עשר טבלאות מורחבות (core: false) מתועדות להרחבה עתידית ואינן בשימוש התהליכים. הבסיס מוקם ריק, בלי נתוני דמו.",
    "placeholderBaseId": "appXXXXXXXXXXXXXX"
  },
  "conventions": {
    "fieldNames": "שמות השדות באנגלית, PascalCase, ומוקלדים ב-Airtable בדיוק כפי שהם מופיעים כאן (רגיש לאותיות גדולות וקטנות).",
    "statusFields": "שדות Status (וגם DocType, Priority, Source) הם singleLineText ולא singleSelect, כדי שתהליך שכותב ערך חדש לא ייכשל. הערכים המותרים מתועדים ב-allowedValues ונאכפים בתהליכים.",
    "foreignKeys": "קשרים בין טבלאות הם מפתחות טקסט קריאים (למשל CUST-0001, ORD-0001, SUP-0001) ולא שדות Linked record.",
    "createdField": "השדה Created חייב להיות מסוג Created time. טריגרי Airtable ב-n8n סורקים לפיו, ובלעדיו התהליכים לא יופעלו.",
    "currency": "שדות currency מוגדרים בשקלים (סימן ₪, שתי ספרות אחרי הנקודה). Amount הוא סכום לפני מע\"מ.",
    "percent": "שדות percent נשמרים ב-API כשבר עשרוני: 18% נכתב ונקרא כ-0.18.",
    "dates": "שדות date נכתבים ב-API בפורמט ISO (YYYY-MM-DD) ומוצגים בממשק בפורמט dd/mm/yyyy.",
    "ids": "מזהי רשומה (rec...) נוצרים על ידי Airtable; מזהים עסקיים (CustomerId, Sku) מנוהלים על ידי העסק.",
