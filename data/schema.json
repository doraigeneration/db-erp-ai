        { "name": "DocType", "airtableType": "singleLineText", "description": "סוג המסמך.", "required": true, "allowedValues": ["חשבונית", "חשבונית מס", "קבלה"], "example": "חשבונית מס" },
        { "name": "CustomerId", "airtableType": "singleLineText", "description": "מפתח טקסט ללקוח (טבלת Customers).", "required": true, "example": "CUST-0001" },
