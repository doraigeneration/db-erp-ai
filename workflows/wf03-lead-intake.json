            },
            {
              "id": "e4bcc5cc-4c13-495f-8e5e-31f2a6a01b24",
              "name": "interest",
              "value": "={{ String($json.body?.interest ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "7ddecdd3-97fd-422c-bce5-9a32a0a3ed6e",
              "name": "source",
              "value": "={{ String($json.body?.source ?? '').trim() || 'Website' }}",
              "type": "string"
            },
