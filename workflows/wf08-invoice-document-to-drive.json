            {
              "id": "c9387d04-110a-437a-b6c0-eb51889fd044",
              "name": "html",
              "value": "=<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n<meta charset=\"UTF-8\">\n<title>{{ $json.DocTitle }} {{ $json.DocNumber }} | קילוהרץ אלקטרוניקה</title>\n<style>\n@page { size: A4; margin: 14mm; }\n* { box-sizing: border-box; }\nbody { margin: 0; background: #ffffff; color: #1f2933; font-family: Arial, \"Segoe UI\", Tahoma, sans-serif; font-size: 13px; line-height: 1.55; }\n.sheet { width: 182mm; margin: 0 auto; padding: 6mm 0; }\n.top { display: table; width: 100%; border-bottom: 3px solid #0b6e6e; padding-bottom: 10px; }\n.brand, .doc { display: table-cell; vertical-align: top; }\n.brand-name { font-size: 22px; font-weight: bold; color: #0b6e6e; margin: 0; }\n.brand-sub { color: #52606d; font-size: 12px; margin: 2px 0 0; }\n.doc { text-align: left; }\n.doc-title { font-size: 24px; font-weight: bold; margin: 0; color: #1f2933; }\n.doc-meta { margin: 4px 0 0; color: #3e4c59; }\n.tag { display: inline-block; border: 1px solid #0b6e6e; color: #0b6e6e; padding: 1px 8px; font-size: 11px; margin-top: 6px; }\n.boxes { display: table; width: 100%; margin: 16px 0; border-spacing: 0; }\n.box { display: table-cell; width: 50%; vertical-align: top; padding: 10px 12px; background: #f3f7f7; border: 1px solid #d9e2e2; }\n.box h3 { margin: 0 0 6px; font-size: 12px; color: #0b6e6e; text-transform: none; }\n.box p { margin: 2px 0; }\ntable.lines { width: 100%; border-collapse: collapse; margin-top: 4px; }\ntable.lines th { background: #0b6e6e; color: #ffffff; text-align: right; padding: 8px 10px; font-weight: bold; }\ntable.lines td { padding: 10px; border-bottom: 1px solid #d9e2e2; }\ntable.lines .num { text-align: left; width: 32%; white-space: nowrap; }\n.totals { width: 52%; margin: 14px auto 0 0; border-collapse: collapse; }\n.totals td { padding: 6px 10px; }\n.totals .num { text-align: left; white-space: nowrap; }\n.totals tr.grand td { border-top: 2px solid #1f2933; font-size: 16px; font-weight: bold; padding-top: 9px; }\n.notes { margin-top: 18px; padding: 10px 12px; border-right: 3px solid #0b6e6e; background: #fafcfc; min-height: 40px; }\n.notes h3 { margin: 0 0 4px; font-size: 12px; color: #0b6e6e; }\n.foot { margin-top: 28px; padding-top: 8px; border-top: 1px solid #d9e2e2; text-align: center; color: #7b8794; font-size: 11px; }\n</style>\n</head>\n<body>\n<div class=\"sheet\">\n\n  <div class=\"top\">\n    <div class=\"brand\">\n      <p class=\"brand-name\">קילוהרץ אלקטרוניקה</p>\n      <p class=\"brand-sub\">Kilohertz Electronics</p>\n      <p class=\"brand-sub\">רחוב המלאכה 14, פתח תקווה</p>\n      <p class=\"brand-sub\">ח.פ. 516000000 · טלפון 03-0000000</p>\n      <p class=\"brand-sub\">sales@kilohertz.example · kilohertz.example</p>\n    </div>\n    <div class=\"doc\">\n      <p class=\"doc-title\">{{ $json.DocTitle }}</p>\n      <p class=\"doc-meta\">מספר מסמך: <strong>{{ $json.DocNumber }}</strong></p>\n      <p class=\"doc-meta\">תאריך הפקה: {{ $json.IssueDate }}</p>\n      <span class=\"tag\">מקור</span>\n    </div>\n  </div>\n\n  <div class=\"boxes\">\n    <div class=\"box\">\n      <h3>פרטי הלקוח</h3>\n      <p><strong>{{ $json.CustomerName }}</strong></p>\n      <p>מספר לקוח: {{ $json.CustomerId }}</p>\n      <p>דוא\"ל: {{ $json.CustomerEmail }}</p>\n    </div>\n    <div class=\"box\">\n      <h3>פרטי המסמך</h3>\n      <p>סוג מסמך: {{ $json.DocTitle }}</p>\n      <p>שיעור מע\"מ: {{ $json.VatRatePercent }}%</p>\n      <p>מטבע: שקל חדש (₪)</p>\n    </div>\n  </div>\n\n  <table class=\"lines\">\n    <thead>\n      <tr>\n        <th>תיאור</th>\n        <th class=\"num\">סכום לפני מע\"מ</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>מוצרים ושירותים לפי הזמנה</td>\n        <td class=\"num\">₪ {{ $json.AmountText }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <table class=\"totals\">\n    <tr>\n      <td>לפני מע\"מ</td>\n      <td class=\"num\">₪ {{ $json.AmountText }}</td>\n    </tr>\n    <tr>\n      <td>מע\"מ {{ $json.VatRatePercent }}%</td>\n      <td class=\"num\">₪ {{ $json.VatAmountText }}</td>\n    </tr>\n    <tr class=\"grand\">\n      <td>סה\"כ לתשלום</td>\n      <td class=\"num\">₪ {{ $json.TotalText }}</td>\n    </tr>\n  </table>\n\n  <div class=\"notes\">\n    <h3>הערות</h3>\n    <div>{{ $json.Notes }}</div>\n  </div>\n\n  <div class=\"foot\">\n    מסמך ממוחשב — הופק אוטומטית על ידי מערכת ERP-AI\n    <br>קילוהרץ אלקטרוניקה · ח.פ. 516000000 · service@kilohertz.example\n  </div>\n\n</div>\n</body>\n</html>\n",
              "type": "string"
            },
