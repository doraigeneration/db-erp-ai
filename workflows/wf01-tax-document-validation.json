    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0a04a64d-e881-4d8b-9a9d-67f9b984dea2",
              "name": "recordId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a1c4fa51-d916-49a8-8d6d-f5554dc8e53a",
              "name": "VatRate",
              "value": "={{ (String($json.fields.IssueDate ?? '').slice(0, 10) !== '' && String($json.fields.IssueDate).slice(0, 10) < '2025-01-01' ? 0.17 : 0.18) }}",
              "type": "number"
            },
            {
              "id": "0f2cf0bb-a0eb-455b-b859-a58b4f04bdfc",
              "name": "VatAmount",
              "value": "={{ Math.round((Number($json.fields.Amount) || 0) * (String($json.fields.IssueDate ?? '').slice(0, 10) !== '' && String($json.fields.IssueDate).slice(0, 10) < '2025-01-01' ? 0.17 : 0.18) * 100) / 100 }}",
              "type": "number"
            },
            {
              "id": "dc0b6269-3914-4f2b-be7e-dbb6b0d6c5c6",
              "name": "Total",
              "value": "={{ Math.round(((Number($json.fields.Amount) || 0) + Math.round((Number($json.fields.Amount) || 0) * (String($json.fields.IssueDate ?? '').slice(0, 10) !== '' && String($json.fields.IssueDate).slice(0, 10) < '2025-01-01' ? 0.17 : 0.18) * 100) / 100) * 100) / 100 }}",
              "type": "number"
            },
            {
              "id": "c794d3f5-31ab-4ebf-914d-7232644b99e7",
              "name": "isValid",
              "value": "={{ (Number($json.fields.Amount) || 0) > 0 && String($json.fields.CustomerId ?? '').trim() !== '' && ['חשבונית', 'חשבונית מס', 'קבלה'].includes(String($json.fields.DocType ?? '').trim()) && ['', 'New'].includes(String($json.fields.Status ?? '').trim()) }}",
              "type": "boolean"
            },
            {
              "id": "2655462a-56c4-406e-8324-52ab00fe6460",
              "name": "failedChecks",
              "value": "={{ [(Number($json.fields.Amount) || 0) > 0 ? '' : 'הסכום (Amount) חסר או אינו גדול מאפס', String($json.fields.CustomerId ?? '').trim() !== '' ? '' : 'חסר מזהה לקוח (CustomerId)', ['חשבונית', 'חשבונית מס', 'קבלה'].includes(String($json.fields.DocType ?? '').trim()) ? '' : 'סוג המסמך (DocType) חייב להיות חשבונית, חשבונית מס או קבלה', ['', 'New'].includes(String($json.fields.Status ?? '').trim()) ? '' : 'הסטטוס הנוכחי אינו New ולכן המסמך לא נכנס לתור' ].filter(Boolean).join(' | ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
